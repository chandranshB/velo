link "user32"
link "gdi32"
link "kernel32"

# Window Styles
const WS_OVERLAPPED: u32 = 0x00000000
const WS_CAPTION: u32 = 0x00C00000
const WS_SYSMENU: u32 = 0x00080000
const WS_THICKFRAME: u32 = 0x00040000
const WS_MINIMIZEBOX: u32 = 0x00020000
const WS_MAXIMIZEBOX: u32 = 0x00010000
const WS_VISIBLE: u32 = 0x10000000
const WS_OVERLAPPEDWINDOW: u32 = 0x00CF0000
const CW_USEDEFAULT: i32 = -2147483648

# Class Styles
const CS_VREDRAW: u32 = 0x0001
const CS_HREDRAW: u32 = 0x0002
const CS_DBLCLKS: u32 = 0x0008

# Window Messages
const WM_DESTROY: u32 = 0x0002
const WM_SIZE: u32 = 0x0005
const WM_PAINT: u32 = 0x000F
const WM_CLOSE: u32 = 0x0010
const WM_ERASEBKGND: u32 = 0x0014
const WM_KEYDOWN: u32 = 0x0100
const WM_TIMER: u32 = 0x0113
const WM_MOUSEMOVE: u32 = 0x0200
const WM_LBUTTONDOWN: u32 = 0x0201
const WM_LBUTTONUP: u32 = 0x0202
const WM_RBUTTONDOWN: u32 = 0x0204

# ShowWindow & Cursors & Keys
const SW_SHOW: i32 = 5
const IDC_ARROW: u64 = 32512
const IDC_HAND: u64 = 32649
const VK_ESCAPE: u64 = 0x1B
const VK_SPACE: u64 = 0x20
const VK_R: u64 = 0x52

# GDI Constants
const TRANSPARENT: i32 = 1
const OPAQUE: i32 = 2
const PS_SOLID: i32 = 0
const PS_NULL: i32 = 5
const SRCCOPY: u32 = 0x00CC0020
const CLEARTYPE_QUALITY: u32 = 5
const FW_NORMAL: i32 = 400
const FW_SEMIBOLD: i32 = 600
const FW_BOLD: i32 = 700
const DT_CENTER: u32 = 0x00000001
const DT_VCENTER: u32 = 0x00000004
const DT_SINGLELINE: u32 = 0x00000020
const DT_LEFT: u32 = 0x00000000

const MB_OK: u32 = 0x00000000
const MB_ICONINFORMATION: u32 = 0x00000040
const GWLP_USERDATA: i32 = -21
const NULL_BRUSH: i32 = 5
const WHITE_BRUSH: i32 = 0
const BLACK_BRUSH: i32 = 4

struct POINT:
    x: i32
    y: i32

struct RECT:
    left: i32
    top: i32
    right: i32
    bottom: i32

struct WNDCLASSEXW:
    cbSize: u32
    style: u32
    lpfnWndProc: fn(ptr, u32, u64, i64) -> i64
    cbClsExtra: i32
    cbWndExtra: i32
    hInstance: ptr
    hIcon: ptr
    hCursor: ptr
    hbrBackground: ptr
    lpszMenuName: *u16
    lpszClassName: *u16
    hIconSm: ptr

struct MSG:
    hwnd: ptr
    message: u32
    wParam: u64
    lParam: i64
    time: u32
    pt: POINT

struct PAINTSTRUCT:
    hdc: ptr
    fErase: i32
    rcPaint: RECT
    fRestore: i32
    fIncUpdate: i32
    rgbReserved: [u8; 32]

# Kernel32
extern def GetModuleHandleW(lpModuleName: *u16) -> ptr

# User32
extern def SetProcessDPIAware() -> i32
extern def LoadCursorW(hInstance: ptr, lpCursorName: ptr) -> ptr
extern def SetCursor(hCursor: ptr) -> ptr
extern def RegisterClassExW(lpwcx: *WNDCLASSEXW) -> u16
extern def CreateWindowExW(
    dwExStyle: u32,
    lpClassName: *u16,
    lpWindowName: *u16,
    dwStyle: u32,
    X: i32,
    Y: i32,
    nWidth: i32,
    nHeight: i32,
    hWndParent: ptr,
    hMenu: ptr,
    hInstance: ptr,
    lpParam: ptr
) -> ptr
extern def ShowWindow(hWnd: ptr, nCmdShow: i32) -> i32
extern def UpdateWindow(hWnd: ptr) -> i32
extern def GetMessageW(lpMsg: *MSG, hWnd: ptr, wMsgFilterMin: u32, wMsgFilterMax: u32) -> i32
extern def TranslateMessage(lpMsg: *MSG) -> i32
extern def DispatchMessageW(lpMsg: *MSG) -> i64
extern def DefWindowProcW(hWnd: ptr, Msg: u32, wParam: u64, lParam: i64) -> i64
extern def PostQuitMessage(nExitCode: i32)
extern def InvalidateRect(hWnd: ptr, lpRect: *RECT, bErase: i32) -> i32
extern def GetClientRect(hWnd: ptr, lpRect: *RECT) -> i32
extern def BeginPaint(hWnd: ptr, lpPaint: *PAINTSTRUCT) -> ptr
extern def EndPaint(hWnd: ptr, lpPaint: *PAINTSTRUCT) -> i32
extern def FillRect(hDC: ptr, lprc: *RECT, hbr: ptr) -> i32
extern def DrawTextW(hdc: ptr, lpchText: *u16, cchText: i32, lprc: *RECT, format: u32) -> i32
extern def DrawTextA(hdc: ptr, lpchText: cstr, cchText: i32, lprc: *RECT, format: u32) -> i32
extern def SetWindowLongPtrW(hWnd: ptr, nIndex: i32, dwNewLong: i64) -> i64
extern def GetWindowLongPtrW(hWnd: ptr, nIndex: i32) -> i64
extern def SetTimer(hWnd: ptr, nIDEvent: u64, uElapse: u32, lpTimerFunc: ptr) -> u64
extern def KillTimer(hWnd: ptr, uIDEvent: u64) -> i32
extern def MessageBoxW(hWnd: ptr, lpText: *u16, lpCaption: *u16, uType: u32) -> i32
extern def MessageBoxA(hWnd: ptr, lpText: cstr, lpCaption: cstr, uType: u32) -> i32
extern def SetWindowTextW(hWnd: ptr, lpString: *u16) -> i32

# GDI32
extern def CreateSolidBrush(color: u32) -> ptr
extern def CreatePen(iStyle: i32, cWidth: i32, color: u32) -> ptr
extern def CreateFontW(
    cHeight: i32,
    cWidth: i32,
    cEscapement: i32,
    cOrientation: i32,
    cWeight: i32,
    bItalic: u32,
    bUnderline: u32,
    bStrikeOut: u32,
    iCharSet: u32,
    iOutPrecision: u32,
    iClipPrecision: u32,
    iQuality: u32,
    iPitchAndFamily: u32,
    pszFaceName: *u16
) -> ptr
extern def SelectObject(hdc: ptr, h: ptr) -> ptr
extern def DeleteObject(ho: ptr) -> i32
extern def SetBkMode(hdc: ptr, mode: i32) -> i32
extern def SetTextColor(hdc: ptr, color: u32) -> u32
extern def Rectangle(hdc: ptr, left: i32, top: i32, right: i32, bottom: i32) -> i32
extern def RoundRect(hdc: ptr, left: i32, top: i32, right: i32, bottom: i32, width: i32, height: i32) -> i32
extern def Ellipse(hdc: ptr, left: i32, top: i32, right: i32, bottom: i32) -> i32
extern def MoveToEx(hdc: ptr, x: i32, y: i32, lppt: *POINT) -> i32
extern def LineTo(hdc: ptr, x: i32, y: i32) -> i32
extern def CreateCompatibleDC(hdc: ptr) -> ptr
extern def CreateCompatibleBitmap(hdc: ptr, cx: i32, cy: i32) -> ptr
extern def DeleteDC(hdc: ptr) -> i32
extern def BitBlt(hdc: ptr, x: i32, y: i32, cx: i32, cy: i32, hdcSrc: ptr, x1: i32, y1: i32, rop: u32) -> i32
extern def GetStockObject(i: i32) -> ptr

inline def rgb(r: u32, g: u32, b: u32) -> u32:
    return (r & 255) | ((g & 255) << 8) | ((b & 255) << 16)

inline def lparam_x(lparam: i64) -> i32:
    let raw = (lparam & 0xFFFF) as i32
    return raw - 65536 if raw >= 32768 else raw

inline def lparam_y(lparam: i64) -> i32:
    let raw = ((lparam >> 16) & 0xFFFF) as i32
    return raw - 65536 if raw >= 32768 else raw
