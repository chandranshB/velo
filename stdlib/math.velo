const PI: f64 = 3.14159265358979323846
const TAU: f64 = 6.28318530717958647692
const E: f64 = 2.71828182845904523536

inline def square(x: f64) -> f64:
    return x * x

inline def lerp(a: f64, b: f64, t: f64) -> f64:
    return a + (b - a) * t

inline def clamp_f64(x: f64, lo: f64, hi: f64) -> f64:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

inline def clamp_i32(x: i32, lo: i32, hi: i32) -> i32:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x

inline def gcd(a: i64, b: i64) -> i64:
    var x = a if a >= 0 else -a
    var y = b if b >= 0 else -b
    while y != 0:
        let t = x % y
        x = y
        y = t
    return x
